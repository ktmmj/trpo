# ─── Application ─────────────────────────────────────────────
APP_NAME=ServiceDesk
APP_VERSION=1.0.0
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO

# ─── HTTP ────────────────────────────────────────────────────
APP_HOST=127.0.0.1
APP_PORT=10000
WORKERS=2

# ─── Database ────────────────────────────────────────────────
# SQLite (по умолчанию) — путь к файлу внутри контейнера
DATABASE_URL=sqlite:////data/servicedesk.db
# Пример для PostgreSQL (если раскомментировать — потребуется драйвер)
# DATABASE_URL=postgresql+psycopg://servicedesk:servicedesk@db:5432/servicedesk
DB_ECHO=false

# ─── Security ────────────────────────────────────────────────
# Сгенерируйте: python -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-in-production
TOKEN_TTL_HOURS=12
PBKDF2_ITERATIONS=200000

# ─── Seed (dev only) ─────────────────────────────────────────
# Пароли для seed-пользователей из seed.sql, проставляются на старте
SEED_PASSWORDS=true
SEED_CLIENT_PASSWORD=client123
SEED_OPERATOR_PASSWORD=operator123

# ─── Health / readiness ──────────────────────────────────────
HEALTH_CHECK_DB=true